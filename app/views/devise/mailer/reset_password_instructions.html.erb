<%
  recipient_name = @resource.name.presence || @resource.email
  reset_url = frontend_url('auth/password/edit', reset_password_token: @token)
%>

<tr>
  <td style="padding: 0 0 16px;">
    <span style="display: inline-block; padding: 6px 10px; border-radius: 999px; background-color: #FFF0F6; color: #F40064; font-size: 12px; line-height: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;">
      Segurança
    </span>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 12px;">
    <h1 style="margin: 0; font-size: 32px; line-height: 38px; font-weight: 700; color: #0B0E30;">Redefina sua senha</h1>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 8px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #334155;">Olá, <%= recipient_name %>.</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 10px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #475569;">Recebemos uma solicitação para alterar a senha do seu acesso ao Gquicks HUB - Atendimento Web.</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 24px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #475569;">Clique no botão abaixo para criar uma nova senha. Se você não fez essa solicitação, ignore este e-mail.</p>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0;">
      <tr>
        <td bgcolor="#F40064" style="border-radius: 14px; background-color: #F40064;">
          <%= link_to(
            'Criar nova senha',
            reset_url,
            style: 'display:block; width:100%; box-sizing:border-box; padding:12px 24px; font-size:14px; line-height:20px; font-weight:700; color:#FFFFFF; text-align:center; text-decoration:none;'
          ) %>
        </td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td style="padding: 0 0 20px;">
    <p style="margin: 0; font-size: 14px; line-height: 21px; color: #64748B;">
      Sua senha só será alterada depois que você acessar o link e salvar uma nova senha.
      Se o botão não funcionar, abra
      <%= link_to(
        'este link seguro',
        reset_url,
        style: 'color:#F40064; text-decoration:none; font-weight:600;'
      ) %>.
    </p>
  </td>
</tr>
